Creating Storage Vol

cat <<'EOF' > ~/hpp.yaml
apiVersion: hostpathprovisioner.kubevirt.io/v1beta1
kind: HostPathProvisioner
metadata:
  name: hostpath-provisioner
  namespace: openshift-cnv
spec:
  imagePullPolicy: IfNotPresent
  storagePools:
  - name: vm-storage
    path: /var/mnt/vm-storage
  workload:
    nodeSelector:
      kubernetes.io/os: linux
EOF
oc apply -f ~/hpp.yaml

oc get hostpathprovisioner -n openshift-cnv
oc get pods -n openshift-cnv | grep -i hostpath

cat <<'EOF' > ~/hpp-storageclass.yaml
apiVersion: storage.k8s.io/v1
kind: StorageClass
metadata:
  name: hpp-local
  annotations:
    storageclass.kubernetes.io/is-default-class: "true"
    storageclass.kubevirt.io/is-default-virt-class: "true"
provisioner: kubevirt.io.hostpath-provisioner
reclaimPolicy: Delete
volumeBindingMode: WaitForFirstConsumer
parameters:
  storagePool: vm-storage
EOF

oc apply -f ~/hpp-storageclass.yaml
oc get storageclass
oc get hostpathprovisioner hostpath-provisioner -n openshift-cnv -o yaml


