Setup Network for all systems

oc project vm-lab
virtctl expose vm windows-2022-appserver   --name=app01   --port=8080   --target-port=8080   --type=ClusterIP   -n vm-lab
virtctl expose vm windows-2022-db   --name=db01   --port=1433   --target-port=1433   --type=ClusterIP   -n vm-lab
virtctl expose vm windows-2022-smb   --name=file01   --port=445   --target-port=445   --type=ClusterIP   -n vm-lab
virtctl expose vm windows-2022-webserver   --name=web01   --port=80   --target-port=80   --type=ClusterIP   -n vm-lab
oc get svc -n vm-lab

Tomcat:

New-NetFirewallRule `
  -DisplayName "Tomcat 8080" `
  -Direction Inbound `
  -Protocol TCP `
  -LocalPort 8080 `
  -Action Allow

Get-NetFirewallRule -DisplayName "Tomcat 8080"

