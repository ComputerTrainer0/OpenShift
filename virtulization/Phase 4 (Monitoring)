New-NetFirewallRule `
  -DisplayName "Windows Exporter 9182" `
  -Direction Inbound `
  -Protocol TCP `
  -LocalPort 9182 `
  -Action Allow


Allow on all pc

Create monitoring config service

oc create configmap cluster-monitoring-config \
  -n openshift-monitoring \
  --from-literal=config.yaml='enableUserWorkload: true'


oc get configmap cluster-monitoring-config \
  -n openshift-monitoring \
  -o yaml

oc get pods -n openshift-user-workload-monitoring



cat > web01-servicemonitor.yaml <<'EOF'
apiVersion: monitoring.coreos.com/v1
kind: ServiceMonitor
metadata:
  name: web01-windows-exporter
  namespace: vm-lab
spec:
  selector:
    matchLabels:
      app: web01-metrics
  endpoints:
  - port: metrics
    interval: 30s
    path: /metrics
EOF

oc label svc web01-metrics \
  app=web01-metrics \
  -n vm-lab \
  --overwrite

oc patch svc web01-metrics \
  -n vm-lab \
  --type='json' \
  -p='[
    {
      "op":"replace",
      "path":"/spec/ports/0/name",
      "value":"metrics"
    }
  ]'

oc get svc web01-metrics -n vm-lab -o yaml

oc apply -f web01-servicemonitor.yaml

