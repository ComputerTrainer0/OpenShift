<h2>Create New Order</h2>

<%
String dbUrl =
    "jdbc:sqlserver://db01.vm-lab.svc.cluster.local:1433;" +
    "databaseName=LegacyOrders;" +
    "encrypt=true;" +
    "trustServerCertificate=true;";

String dbUser = "legacyapp";
String dbPassword = "R3dCloud!Sql#2026$Lab9";

/*
 * SMB File Server
 *
 * Actual destination:
 * \\file01.vm-lab.svc.cluster.local\LegacyData\Invoices
 */
String invoiceDirectory =
    "\\\\file01.vm-lab.svc.cluster.local\\LegacyData\\Invoices";

String message = "";
boolean success = false;

if ("POST".equalsIgnoreCase(request.getMethod())) {

    String customerIdText = request.getParameter("customerId");
    String totalAmountText = request.getParameter("totalAmount");

    Connection conn = null;

    try {

        int customerId = Integer.parseInt(customerIdText);
        BigDecimal totalAmount =
            new BigDecimal(totalAmountText);

        Class.forName(
            "com.microsoft.sqlserver.jdbc.SQLServerDriver"
        );

        conn = DriverManager.getConnection(
            dbUrl,
            dbUser,
            dbPassword
        );

        /*
         * ------------------------------------------------
         * 1. Find customer name
         * ------------------------------------------------
         */

        String customerName = "";

        String customerSql =
            "SELECT CustomerName " +
            "FROM Customers " +
            "WHERE CustomerID = ?";

        PreparedStatement customerPs =
            conn.prepareStatement(customerSql);

        customerPs.setInt(1, customerId);

        ResultSet customerRs =
            customerPs.executeQuery();

        if (customerRs.next()) {

            customerName =
                customerRs.getString("CustomerName");

        } else {

            throw new Exception(
                "Customer ID does not exist."
            );
        }

        customerRs.close();
        customerPs.close();


        /*
         * ------------------------------------------------
         * 2. Insert order
         * ------------------------------------------------
         */

        String insertSql =
            "INSERT INTO Orders " +
            "(CustomerID, Status, TotalAmount) " +
            "VALUES (?, 'NEW', ?)";

        PreparedStatement insertPs =
            conn.prepareStatement(
                insertSql,
                Statement.RETURN_GENERATED_KEYS
            );

        insertPs.setInt(
            1,
            customerId
        );

        insertPs.setBigDecimal(
            2,
            totalAmount
        );

        int rows =
            insertPs.executeUpdate();

        if (rows != 1) {

            throw new Exception(
                "Order insert failed."
            );
        }


        /*
         * ------------------------------------------------
         * 3. Get generated OrderID
         * ------------------------------------------------
         */

        ResultSet generatedKeys =
            insertPs.getGeneratedKeys();

        int orderId;

        if (generatedKeys.next()) {

            orderId =
                generatedKeys.getInt(1);

        } else {

            throw new Exception(
                "Unable to retrieve new Order ID."
            );
        }

        generatedKeys.close();
        insertPs.close();


        /*
         * ------------------------------------------------
         * 4. Generate invoice
         * ------------------------------------------------
         */

        String invoiceFileName =
            "invoice-" + orderId + ".txt";

        Path invoiceFolder =
            Paths.get(invoiceDirectory);

        Path invoiceFile =
            invoiceFolder.resolve(
                invoiceFileName
            );

        String invoiceContent =
            "========================================\r\n" +
            "       LEGACY ORDER MANAGEMENT\r\n" +
            "========================================\r\n" +
            "\r\n" +
            "Invoice / Order ID : " + orderId + "\r\n" +
            "Customer           : " + customerName + "\r\n" +
            "Customer ID        : " + customerId + "\r\n" +
            "Order Status       : NEW\r\n" +
            "Total Amount       : GBP " + totalAmount + "\r\n" +
            "Created            : " + LocalDateTime.now() + "\r\n" +
            "\r\n" +
            "Generated by LegacyOrders Tomcat Application\r\n" +
            "\r\n" +
            "========================================\r\n";

        /*
         * Creates folder if necessary.
         */
        Files.createDirectories(
            invoiceFolder
        );

        /*
         * Write invoice.
         */
        Files.writeString(
            invoiceFile,
            invoiceContent,
            StandardCharsets.UTF_8,
            StandardOpenOption.CREATE,
            StandardOpenOption.TRUNCATE_EXISTING
        );


        /*
         * ------------------------------------------------
         * 5. Update Orders table with invoice location
         * ------------------------------------------------
         */

        String invoicePath =
            invoiceFile.toString();

        String updateSql =
            "UPDATE Orders " +
            "SET InvoicePath = ? " +
            "WHERE OrderID = ?";

        PreparedStatement updatePs =
            conn.prepareStatement(updateSql);

        updatePs.setString(
            1,
            invoicePath
        );

        updatePs.setInt(
            2,
            orderId
        );

        updatePs.executeUpdate();

        updatePs.close();


        /*
         * ------------------------------------------------
         * 6. Write AuditLog entry
         * ------------------------------------------------
         */

        String auditSql =
            "INSERT INTO AuditLog " +
            "(EventType, Description) " +
            "VALUES (?, ?)";

        PreparedStatement auditPs =
            conn.prepareStatement(auditSql);

        auditPs.setString(
            1,
            "ORDER_CREATED"
        );

        auditPs.setString(
            2,
            "Order " + orderId +
            " created for " +
            customerName +
            ". Invoice: " +
            invoicePath
        );

        auditPs.executeUpdate();

        auditPs.close();


        /*
         * ------------------------------------------------
         * SUCCESS
         * ------------------------------------------------
         */

        success = true;

        message =
            "Order " +
            orderId +
            " created successfully. " +
            "Invoice generated: " +
            invoiceFileName;


    } catch (Exception e) {

        message =
            "ERROR: " +
            e.toString();

    } finally {

        try {

            if (conn != null) {
                conn.close();
            }

        } catch (Exception ignore) {
        }

    }
}
%>


<% if (!message.isEmpty()) { %>

    <% if (success) { %>

