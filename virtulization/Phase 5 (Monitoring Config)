Channel: stable
Installation mode: All namespaces
Namespace: openshift-cluster-observability-operator
Update approval: Automatic

==================
create datasource for prometheus configuration.
oc create serviceaccount perses-sa -n vm-lab
Grant it monitoring read access:
oc adm policy add-cluster-role-to-user \
  cluster-monitoring-view \
  -z perses-sa \
  -n vm-lab
Create a token:
TOKEN=$(oc create token perses-sa \
  -n vm-lab \
  --duration=8760h)

Create/update the datasource secret:
oc create secret generic prometheus-datasource-secret \
  -n vm-lab \
  --from-literal=Authorization="Bearer ${TOKEN}" \
  --dry-run=client -o yaml | oc apply -f -

Now create the datasource:
oc apply -f - <<'EOF'
apiVersion: perses.dev/v1alpha2
kind: PersesDatasource
metadata:
  name: prometheus-datasource
  namespace: vm-lab
spec:
  config:
    display:
      name: "OpenShift Thanos Querier"
    default: true
    plugin:
      kind: PrometheusDatasource
      spec:
        proxy:
          kind: HTTPProxy
          spec:
            url: https://thanos-querier.openshift-monitoring.svc.cluster.local:9091
            secret: prometheus-datasource-secret
  client:
    tls:
      enable: true
      caCert:
        type: file
        certPath: /ca/service-ca.crt
EOF

Then verify:
oc get persesdatasource -n vm-lab

